# Load via: node --env-file=.env scripts/refresh.mjs --dry-run
BQ_PROJECT=
SNAPSHOT_END=
BQ_MAX_BYTES=200000000000
# Optional. Never expose a token to the browser.
GITHUB_TOKEN=
SKIP_GITHUB=0

# Optional authenticated access for the separate 84-day signer study.
NEARBLOCKS_API_KEY=
NEARBLOCKS_PAGE_CAP=8

# Per-query scan limits for scripts/live-rankings.mjs.
BQ_PROJECT_MAX_BYTES=35000000000
BQ_DEPLOYMENT_MAX_BYTES=130000000000

# PostgreSQL project activity service (PostgreSQL 14+).
DATABASE_URL=
BQ_HISTORY_MAX_BYTES=10000000000
# Optional path to an expanded evidence-backed registry.
# ACTIVITY_REGISTRY=
